generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String      @id @default(cuid())
  username                 String      @unique
  passwordHash             String
  kmRate                   Float       @default(0.23)
  defaultReturnTrip        Boolean     @default(true)
  exportIncludeLocation    Boolean     @default(true)
  exportIncludeRetour      Boolean     @default(true)
  exportIncludeKm          Boolean     @default(true)
  exportIncludeFee         Boolean     @default(true)
  exportIncludeDescription Boolean     @default(true)
  exportIncludePostcodes   Boolean     @default(true)
  homeAddress              String?
  homePostcode             String?
  homePlaceId              String?
  fuelTrackingEnabled      Boolean     @default(false)
  email                    String?
  emailLocale              String      @default("nl")
  weeklyStatsEnabled       Boolean     @default(false)
  weeklyStatsDay           Int         @default(1)
  reminderEnabled          Boolean     @default(false)
  reminderDay              Int         @default(1)
  lastWeeklyStatsSentAt    DateTime?
  lastReminderSentAt       DateTime?
  trips                    Trip[]
  locations                Location[]
  fuelEntries              FuelEntry[]
  createdAt                DateTime    @default(now())
}

model Location {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  name        String
  // Either the user enters a fixed one-way km from home (fixedKm), or it's calculated
  // per trip via Google Maps (kmFromRoute).
  fixedKm     Float      @default(0)
  kmFromRoute Boolean    @default(false)
  address     String?
  postcode    String?
  placeId     String?
  isDefault   Boolean    @default(false)
  stops       TripStop[]
  createdAt   DateTime   @default(now())

  @@index([userId])
}

model Trip {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  date         DateTime
  stops        TripStop[]
  description  String?
  // km: distance of the outbound route (first stop to last stop).
  // returnKm: distance from the last stop back to the first. Null means "same as km",
  // which is how single-destination trips (and all trips from before multi-stop) work.
  km           Float
  returnKm     Float?
  isReturnTrip Boolean    @default(true)
  createdAt    DateTime   @default(now())
}

// Ordered stops of a trip, position 0 being the starting point. A stop is either the
// user's home (isHome, resolved to the current home address from settings), a saved
// Location, or its own name/address/postcode.
model TripStop {
  id         String    @id @default(cuid())
  tripId     String
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  position   Int
  isHome     Boolean   @default(false)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  name       String?
  address    String?
  postcode   String?
  placeId    String?

  @@index([tripId])
  @@index([locationId])
}

model FuelEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime
  odometer      Float
  pricePerLiter Float
  totalPrice    Float
  createdAt     DateTime @default(now())

  @@index([userId])
}
