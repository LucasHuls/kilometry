generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String      @id @default(cuid())
  username                 String      @unique
  passwordHash             String
  kmRate                   Float       @default(0.23)
  defaultReturnTrip        Boolean     @default(true)
  exportIncludeLocation    Boolean     @default(true)
  exportIncludeRetour      Boolean     @default(true)
  exportIncludeKm          Boolean     @default(true)
  exportIncludeFee         Boolean     @default(true)
  exportIncludeDescription Boolean     @default(true)
  fuelTrackingEnabled      Boolean     @default(false)
  email                    String?
  emailLocale              String      @default("nl")
  weeklyStatsEnabled       Boolean     @default(false)
  weeklyStatsDay           Int         @default(1)
  reminderEnabled          Boolean     @default(false)
  reminderDay              Int         @default(1)
  lastWeeklyStatsSentAt    DateTime?
  lastReminderSentAt       DateTime?
  trips                    Trip[]
  locations                Location[]
  fuelEntries              FuelEntry[]
  createdAt                DateTime    @default(now())
}

model Location {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  fixedKm   Float    @default(0)
  isDefault Boolean  @default(false)
  trips     Trip[]
  createdAt DateTime @default(now())

  @@index([userId])
}

model Trip {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  date           DateTime
  locationId     String?
  location       Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customLocation String?
  description    String?
  km             Float
  isReturnTrip   Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model FuelEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime
  odometer      Float
  pricePerLiter Float
  totalPrice    Float
  createdAt     DateTime @default(now())

  @@index([userId])
}
